#include "../imports/stdlib.fc";

;; ============================================================
;; Soulbound Collection (zkTGuard credentials)
;;
;; Owns the Item code and is the only contract authorised to
;; deploy new Items. Mint is restricted to the verifier address
;; (Task 4) — any other sender gets exit 411.
;;
;; Storage layout:
;;     next_index      : uint64
;;     verifier_addr   : MsgAddress
;;     owner_addr      : MsgAddress    (collection admin)
;;     content         : ^cell         (collection-wide metadata)
;;     item_code       : ^cell         (compiled Item code)
;; ============================================================

int equal_slices(slice a, slice b) asm "SDEQ";

const int op::mint         = 0x6d696e74;   ;; "mint"
const int op::set_verifier = 0x73766572;   ;; "sver"

const int err::not_verifier = 411;
const int err::not_owner    = 415;
const int err::unknown_op   = 0xffff;

;; ---------- Storage ----------

(int, slice, slice, cell, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    int next_index = ds~load_uint(64);
    slice verifier = ds~load_msg_addr();
    slice owner    = ds~load_msg_addr();
    cell content   = ds~load_ref();
    cell item_code = ds~load_ref();
    return (next_index, verifier, owner, content, item_code);
}

() save_data(int next_index, slice verifier, slice owner, cell content, cell item_code) impure inline {
    set_data(begin_cell()
        .store_uint(next_index, 64)
        .store_slice(verifier)
        .store_slice(owner)
        .store_ref(content)
        .store_ref(item_code)
        .end_cell());
}

;; ---------- Item address derivation ----------

cell build_item_state_init(cell item_code, int index, slice collection_addr, slice owner_addr, cell content) inline {
    cell data = begin_cell()
        .store_uint(index, 64)
        .store_slice(collection_addr)
        .store_slice(owner_addr)
        .store_ref(content)
        .end_cell();
    return begin_cell()
        .store_uint(0, 2)        ;; split_depth = 0, special = 0
        .store_dict(item_code)
        .store_dict(data)
        .store_uint(0, 1)        ;; library = 0
        .end_cell();
}

slice item_address(cell state_init) inline {
    return begin_cell()
        .store_uint(4, 3)                          ;; addr_std$10, anycast=0
        .store_int(0, 8)                           ;; workchain 0
        .store_uint(cell_hash(state_init), 256)
        .end_cell()
        .begin_parse();
}

() deploy_item(cell state_init, slice dest, int amount) impure inline {
    var msg = begin_cell()
        .store_uint(0x18, 6)                       ;; bounce off, internal
        .store_slice(dest)
        .store_coins(amount)
        .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
        ;; flags + StateInit ref + body ref. Body left empty —
        ;; Item's full state is in the stateInit's data cell.
        .store_ref(state_init)
        .store_ref(begin_cell().end_cell())
        .end_cell();
    send_raw_message(msg, 1);    ;; mode 1: pay forward fees separately
}

;; ---------- Entry point ----------

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }
    slice sender = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    var (next_index, verifier, owner_addr, content, item_code) = load_data();

    if (op == op::set_verifier) {
        throw_unless(err::not_owner, equal_slices(sender, owner_addr));
        slice new_verifier = in_msg_body~load_msg_addr();
        save_data(next_index, new_verifier, owner_addr, content, item_code);
        return ();
    }

    if (op == op::mint) {
        ;; Body: op(32) | query_id(64) | new_owner_addr | ^individual_content
        throw_unless(err::not_verifier, equal_slices(sender, verifier));

        slice new_owner = in_msg_body~load_msg_addr();
        cell ind_content = in_msg_body~load_ref();

        ;; Build self-address (sender from verifier's perspective is THIS contract).
        slice my_addr = begin_cell()
            .store_uint(4, 3)
            .store_int(0, 8)
            .store_uint(0, 256)               ;; placeholder; not relied on
            .end_cell()
            .begin_parse();
        ;; Use my_address() builtin where available.
        ;; (TVM exposes c7 → my_address. The stdlib bundled here is older;
        ;;  read it via the standard primitive.)

        cell init = build_item_state_init(item_code, next_index, my_address(), new_owner, ind_content);
        slice dest = item_address(init);

        ;; Forward some Toncoin to cover deploy + storage.
        ;; v0 uses 0.05 TON; adjustable when Task 9 wires the Mini App.
        deploy_item(init, dest, 50000000);

        save_data(next_index + 1, verifier, owner_addr, content, item_code);
        return ();
    }

    throw(err::unknown_op);
}

;; ---------- Get methods (TEP-62) ----------

(int, cell, slice) get_collection_data() method_id {
    var (next_index, _, owner_addr, content, _) = load_data();
    return (next_index, content, owner_addr);
}

slice get_nft_address_by_index(int index) method_id {
    var (_, _, _, _, item_code) = load_data();
    cell init = build_item_state_init(item_code, index, my_address(), my_address(), begin_cell().end_cell());
    ;; Owner & content are zero here — this getter is only useful in
    ;; deployments where mint pre-images are known. Documented limit;
    ;; full TEP-62 indexing arrives with the Mini App in Task 9.
    return item_address(init);
}

cell get_nft_content(int index, cell individual_content) method_id {
    return individual_content;
}

slice verifier_address() method_id {
    var (_, verifier, _, _, _) = load_data();
    return verifier;
}

int next_index() method_id {
    var (next_index, _, _, _, _) = load_data();
    return next_index;
}
