#include "../imports/stdlib.fc";

;; ============================================================
;; Soulbound NFT Item (zkTGuard credential)
;;
;; Read-side TEP-62 compatible (`get_nft_data`, `get_static_data`)
;; but rejects every transfer or burn op with exit 410. The owner
;; field is immutable for the life of the contract — it is baked
;; into the stateInit produced by the Collection on mint.
;;
;; Storage layout (all set at deploy via stateInit):
;;     index           : uint64
;;     collection      : MsgAddress
;;     owner           : MsgAddress
;;     content         : ^cell    (individual metadata; v0 carries
;;                                  app_id, claim_type, expiration,
;;                                  claim_hash, mint_timestamp)
;; ============================================================

const int op::transfer            = 0x5fcc3d14;
const int op::ownership_assigned  = 0x05138d91;
const int op::get_static_data     = 0x2fcb26a2;
const int op::report_static_data  = 0x8b771735;
const int op::burn                = 0x595f07bc;

const int err::transfer_forbidden = 410;
const int err::unknown_op         = 0xffff;

;; ---------- Storage ----------

(int, slice, slice, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    int index = ds~load_uint(64);
    slice collection = ds~load_msg_addr();
    slice owner = ds~load_msg_addr();
    cell content = ds~load_ref();
    return (index, collection, owner, content);
}

;; ---------- Entry point ----------

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }                   ;; ignore bounced
    slice sender = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);

    ;; Soulbound: no transfer, no ownership reassignment, no burn.
    if (op == op::transfer)           { throw(err::transfer_forbidden); }
    if (op == op::ownership_assigned) { throw(err::transfer_forbidden); }
    if (op == op::burn)               { throw(err::transfer_forbidden); }

    if (op == op::get_static_data) {
        int query_id = in_msg_body~load_uint(64);
        var (index, collection, _, _) = load_data();
        var msg = begin_cell()
            .store_uint(0x10, 6)                  ;; nobounce internal
            .store_slice(sender)
            .store_coins(0)
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(op::report_static_data, 32)
            .store_uint(query_id, 64)
            .store_uint(index, 256)
            .store_slice(collection)
            .end_cell();
        send_raw_message(msg, 64);
        return ();
    }

    throw(err::unknown_op);
}

;; ---------- Get methods (TEP-62) ----------

(int, int, slice, slice, cell) get_nft_data() method_id {
    var (index, collection, owner, content) = load_data();
    return (-1, index, collection, owner, content);
}

(int) get_nft_index() method_id {
    var (index, _, _, _) = load_data();
    return index;
}
