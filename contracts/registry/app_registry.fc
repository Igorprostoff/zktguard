#include "../imports/stdlib.fc";

;; ============================================================
;; App registry (zkTGuard v0.2 Phase C)
;;
;; Canonical on-chain directory of (app_id, claim_type) pairs that
;; the verifier will accept. Storage is flat — pairs are packed into
;; a single 96-bit dict key
;;
;;     key = (app_id << 32) | claim_type
;;
;; with empty value cells (presence is the data). app_id is 64 bits,
;; claim_type is 32 bits.
;;
;; Phase C adds `op::query_registered`: any contract can ask the
;; registry whether a pair is present; the registry replies via
;; `op::query_reply` to the original sender. The verifier uses this
;; for its async parking flow.
;; ============================================================

int equal_slices(slice a, slice b) asm "SDEQ";

const int op::register         = 0x72656769;   ;; "regi"
const int op::deregister       = 0x64657265;   ;; "dere"
const int op::transfer_admin   = 0x61646d6e;   ;; "admn"
const int op::query_registered = 0x71726567;   ;; "qreg"
const int op::query_reply      = 0x7172706c;   ;; "qrpl"

const int err::not_admin      = 420;
const int err::unknown_op     = 0xffff;

const int APP_ID_BITS     = 64;
const int CLAIM_BITS      = 32;
const int KEY_BITS        = 96;            ;; APP_ID_BITS + CLAIM_BITS

;; ---------- Storage ----------

(slice, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    slice admin = ds~load_msg_addr();
    cell apps = ds~load_dict();
    return (admin, apps);
}

() save_data(slice admin, cell apps) impure inline {
    set_data(begin_cell()
        .store_slice(admin)
        .store_dict(apps)
        .end_cell());
}

int pack_key(int app_id, int claim_type) inline {
    return (app_id << CLAIM_BITS) | claim_type;
}

int lookup(cell apps, int app_id, int claim_type) inline {
    int key = pack_key(app_id, claim_type);
    var (_, found) = apps.udict_get?(KEY_BITS, key);
    if (found) { return 1; }
    return 0;
}

() send_reply(slice dest, int query_id, int app_id, int claim_type, int is_reg) impure inline {
    var msg = begin_cell()
        .store_uint(0x10, 6)                 ;; nobounce internal
        .store_slice(dest)
        .store_coins(0)
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(op::query_reply, 32)
        .store_uint(query_id, 64)
        .store_uint(app_id, APP_ID_BITS)
        .store_uint(claim_type, CLAIM_BITS)
        .store_uint(is_reg, 1)
        .end_cell();
    send_raw_message(msg, 64);   ;; carry remaining value of the request
}

;; ---------- Entry point ----------

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }                  ;; ignore bounced
    slice sender = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    var (admin, apps) = load_data();

    if (op == op::query_registered) {
        ;; Public — anyone may ask. No admin gate.
        int app_id = in_msg_body~load_uint(APP_ID_BITS);
        int claim_type = in_msg_body~load_uint(CLAIM_BITS);
        int is_reg = lookup(apps, app_id, claim_type);
        send_reply(sender, query_id, app_id, claim_type, is_reg);
        return ();
    }

    throw_unless(err::not_admin, equal_slices(sender, admin));

    if (op == op::register) {
        int app_id = in_msg_body~load_uint(APP_ID_BITS);
        int claim_type = in_msg_body~load_uint(CLAIM_BITS);
        int key = pack_key(app_id, claim_type);
        apps~udict_set_builder(KEY_BITS, key, begin_cell());
        save_data(admin, apps);
        return ();
    }

    if (op == op::deregister) {
        int app_id = in_msg_body~load_uint(APP_ID_BITS);
        int claim_type = in_msg_body~load_uint(CLAIM_BITS);
        int key = pack_key(app_id, claim_type);
        apps~udict_delete?(KEY_BITS, key);
        save_data(admin, apps);
        return ();
    }

    if (op == op::transfer_admin) {
        slice new_admin = in_msg_body~load_msg_addr();
        save_data(new_admin, apps);
        return ();
    }

    throw(err::unknown_op);
}

;; ---------- Get methods ----------

int is_registered(int app_id, int claim_type) method_id {
    var (_, apps) = load_data();
    return lookup(apps, app_id, claim_type);
}

slice admin_address() method_id {
    var (admin, _) = load_data();
    return admin;
}
