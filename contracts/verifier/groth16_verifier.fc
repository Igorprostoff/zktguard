;; ===========================================================
;; Storage:
;;
;;     admin       : MsgAddress
;;     registry    : MsgAddress (may be addr_none until set)
;;     collection  : MsgAddress (may be addr_none until set)
;;     ref nullifiers_dict : HashmapE(256 → empty)
;;     ref parked_dict     : HashmapE(QUERY_ID_BITS → parked-cell)
;;     next_query_id : uint64
;;
;; A "parked-cell" holds:
;;     nullifier  : 256 bits
;;     app_id     : 64 bits
;;     claim_type : 32 bits
;;     expiration : 64 bits
;;     parked_at  : 32 bits (Unix seconds)
;;     ttl        : 32 bits
;;     original_sender : MsgAddress
;; ===========================================================

(slice, slice, slice, cell, cell, int) load_data() inline {
    slice ds = get_data().begin_parse();
    slice admin = ds~load_msg_addr();
    slice registry = ds~load_msg_addr();
    slice collection = ds~load_msg_addr();
    cell nullifiers = ds~load_dict();
    cell parked = ds~load_dict();
    int next_qid = ds~load_uint(QUERY_ID_BITS);
    return (admin, registry, collection, nullifiers, parked, next_qid);
}

() save_data(slice admin, slice registry, slice collection, cell nullifiers, cell parked, int next_qid) impure inline {
    set_data(begin_cell()
        .store_slice(admin)
        .store_slice(registry)
        .store_slice(collection)
        .store_dict(nullifiers)
        .store_dict(parked)
        .store_uint(next_qid, QUERY_ID_BITS)
        .end_cell());
}

;; ---------- Helpers ----------

slice load_point_slice(cell c, int expected_bits) inline {
    slice s = c.begin_parse();
    throw_unless(err::malformed_input, s.slice_bits() == expected_bits);
    throw_unless(err::malformed_input, s.slice_refs() == 0);
    return s;
}

int chain_id_from_nonce(int nonce) inline {
    return nonce >> NONCE_RANDOM_BITS;
}

(int, int, int, int, int, int, int, int) parse_public_inputs(cell head) inline {
    slice s0 = head.begin_parse();
    int pi0 = s0~load_uint(SCALAR_BITS);
    int pi1 = s0~load_uint(SCALAR_BITS);
    int pi2 = s0~load_uint(SCALAR_BITS);

    cell c1 = s0~load_ref();
    slice s1 = c1.begin_parse();
    int pi3 = s1~load_uint(SCALAR_BITS);
    int pi4 = s1~load_uint(SCALAR_BITS);
    int pi5 = s1~load_uint(SCALAR_BITS);

    cell c2 = s1~load_ref();
    slice s2 = c2.begin_parse();
    int pi6 = s2~load_uint(SCALAR_BITS);
    int pi7 = s2~load_uint(SCALAR_BITS);

    return (pi0, pi1, pi2, pi3, pi4, pi5, pi6, pi7);
}

int verify_groth16(slice a, slice b, slice c, slice vk_x) inline {
    slice neg_alpha = bls_g1_neg(vk_alpha_g1());
    slice neg_vk_x  = bls_g1_neg(vk_x);
    slice neg_c     = bls_g1_neg(c);
    int eq = bls_pairing_4(
        a,         b,
        neg_alpha, vk_beta_g2(),
        neg_vk_x,  vk_gamma_g2(),
        neg_c,     vk_delta_g2()
    );
    if (eq != 0) { return 1; }
    return 0;
}

int is_addr_none(slice addr) inline {
    ;; addr_none has tag 00 in the first two bits. A short slice with
    ;; only those two bits and nothing else is the canonical none.
    return addr.slice_bits() <= 2;
}

cell build_parked_entry(int nullifier, int app_id, int claim_type, int expiration, int parked_at, int ttl, slice sender) inline {
    return begin_cell()
        .store_uint(nullifier, SCALAR_BITS)
        .store_uint(app_id, APP_ID_BITS)
        .store_uint(claim_type, CLAIM_BITS)
        .store_uint(expiration, EXPIRATION_BITS)
        .store_uint(parked_at, TIMESTAMP_BITS)
        .store_uint(ttl, TTL_BITS)
        .store_slice(sender)
        .end_cell();
}

(int, int, int, int, int, int, slice) parse_parked_entry(slice s) inline {
    int nullifier = s~load_uint(SCALAR_BITS);
    int app_id = s~load_uint(APP_ID_BITS);
    int claim_type = s~load_uint(CLAIM_BITS);
    int expiration = s~load_uint(EXPIRATION_BITS);
    int parked_at = s~load_uint(TIMESTAMP_BITS);
    int ttl = s~load_uint(TTL_BITS);
    slice sender = s~load_msg_addr();
    return (nullifier, app_id, claim_type, expiration, parked_at, ttl, sender);
}

() send_registry_query(slice registry, int query_id, int app_id, int claim_type) impure inline {
    var msg = begin_cell()
        .store_uint(0x18, 6)                  ;; bounce off, internal
        .store_slice(registry)
        .store_coins(50000000)                ;; 0.05 TON for gas + reply
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(op::query_registered, 32)
        .store_uint(query_id, QUERY_ID_BITS)
        .store_uint(app_id, APP_ID_BITS)
        .store_uint(claim_type, CLAIM_BITS)
        .end_cell();
    send_raw_message(msg, 1);                  ;; mode 1: pay fees separately
}

() send_collection_mint(slice collection, int query_id, slice new_owner, int app_id, int claim_type, int expiration, int nullifier) impure inline {
    cell content = begin_cell()
        .store_uint(app_id, 64)
        .store_uint(claim_type, 64)
        .store_uint(expiration, 64)
        .store_uint(nullifier, 256)
        .store_uint(now(), 64)
        .end_cell();
    var msg = begin_cell()
        .store_uint(0x18, 6)
        .store_slice(collection)
        .store_coins(100000000)                ;; 0.1 TON
        .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
        .store_uint(op::mint, 32)
        .store_uint(query_id, QUERY_ID_BITS)
        .store_slice(new_owner)
        .store_ref(content)
        .end_cell();
    send_raw_message(msg, 1);
}

;; ===========================================================
;; Entry point
;; ===========================================================

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }
    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) { return (); }
    slice sender = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    var (admin, registry, collection, nullifiers, parked, next_qid) = load_data();

    if (op == op::verify_claim) {
        ;; Body refs: A, B, C, public-inputs head.
        cell c_a  = in_msg_body~load_ref();
        cell c_b  = in_msg_body~load_ref();
        cell c_c  = in_msg_body~load_ref();
        cell c_pi = in_msg_body~load_ref();

        slice a = load_point_slice(c_a, G1_BITS);
        slice b = load_point_slice(c_b, G2_BITS);
        slice c = load_point_slice(c_c, G1_BITS);

        throw_unless(err::not_on_curve_g1, bls_g1_in_group(a));
        throw_unless(err::not_on_curve_g2, bls_g2_in_group(b));
        throw_unless(err::not_on_curve_g1, bls_g1_in_group(c));

        var (pi0, pi1, pi2, pi3, pi4, pi5, pi6, pi7) = parse_public_inputs(c_pi);
        ;; pi0=nullifier, pi1=nonce, pi2=app_id, pi3=expiration,
        ;; pi4=claim_type, pi5=attestor_x, pi6=attestor_y, pi7=threshold

        ;; Cheap pre-checks (do these before the expensive pairing).
        int chain_id = chain_id_from_nonce(pi1);
        throw_unless(err::chain_mismatch, chain_id == CHAIN_ID);
        throw_if(err::expired, now() > pi3);

        ;; Configuration sanity — refuse to park if registry / collection
        ;; are unset.
        throw_if(err::registry_unset, is_addr_none(registry));
        throw_if(err::collection_unset, is_addr_none(collection));

        ;; vk_x = IC[0] + Σ pi_i · IC[i+1]  (split as 4 + 5 terms).
        slice part_a = bls_g1_multiexp_4(
            vk_ic_0(), 1,
            vk_ic_1(), pi0,
            vk_ic_2(), pi1,
            vk_ic_3(), pi2
        );
        slice part_b = bls_g1_multiexp_5(
            vk_ic_4(), pi3,
            vk_ic_5(), pi4,
            vk_ic_6(), pi5,
            vk_ic_7(), pi6,
            vk_ic_8(), pi7
        );
        slice vk_x = bls_g1_add(part_a, part_b);
        int ok = verify_groth16(a, b, c, vk_x);
        throw_unless(err::invalid_proof, ok);

        ;; Park the proof and send the registry query.
        int my_qid = next_qid;
        cell entry = build_parked_entry(pi0, pi2, pi4, pi3, now(), DEFAULT_TTL_SECONDS, sender);
        parked~udict_set_ref(QUERY_ID_BITS, my_qid, entry);
        save_data(admin, registry, collection, nullifiers, parked, my_qid + 1);

        send_registry_query(registry, my_qid, pi2, pi4);
        return ();
    }

    if (op == op::query_reply) {
        ;; Must come from the registry.
        throw_unless(err::not_registry, equal_slices(sender, registry));

        int app_id_reply = in_msg_body~load_uint(APP_ID_BITS);
        int claim_reply  = in_msg_body~load_uint(CLAIM_BITS);
        int is_reg       = in_msg_body~load_uint(1);

        var (entry_cell, found) = parked.udict_get_ref?(QUERY_ID_BITS, query_id);
        throw_unless(err::unknown_query_id, found);

        slice es = entry_cell.begin_parse();
        var (nullifier, p_app, p_claim, p_exp, _parked_at, _ttl, original_sender) = parse_parked_entry(es);

        ;; Sanity: the registry's reply must be about the same pair.
        throw_unless(err::unknown_query_id,
            (p_app == app_id_reply) & (p_claim == claim_reply));

        ;; Drop the parked entry either way.
        parked~udict_delete?(QUERY_ID_BITS, query_id);

        if (is_reg == 0) {
            ;; Registry says no — silently discard. The original
            ;; sender will observe the absence of a credential mint.
            save_data(admin, registry, collection, nullifiers, parked, next_qid);
            return ();
        }

        ;; Registry says yes. Re-run nullifier and expiration checks
        ;; (state can have moved during the round-trip).
        throw_if(err::expired, now() > p_exp);
        var (_, used) = nullifiers.udict_get?(SCALAR_BITS, nullifier);
        throw_if(err::nullifier_used, used);

        nullifiers~udict_set_builder(SCALAR_BITS, nullifier, begin_cell());
        save_data(admin, registry, collection, nullifiers, parked, next_qid);

        send_collection_mint(collection, query_id, original_sender, p_app, p_claim, p_exp, nullifier);
        return ();
    }

    if (op == op::sweep_expired) {
        throw_unless(err::not_admin, equal_slices(sender, admin));
        ;; The caller passes a query_id; if expired we drop it.
        var (entry_cell, found) = parked.udict_get_ref?(QUERY_ID_BITS, query_id);
        if (found) {
            slice es = entry_cell.begin_parse();
            var (_, _, _, _, parked_at, ttl, _) = parse_parked_entry(es);
            if (now() > parked_at + ttl) {
                parked~udict_delete?(QUERY_ID_BITS, query_id);
                save_data(admin, registry, collection, nullifiers, parked, next_qid);
            }
        }
        return ();
    }

    if (op == op::set_registry) {
        throw_unless(err::not_admin, equal_slices(sender, admin));
        slice new_registry = in_msg_body~load_msg_addr();
        save_data(admin, new_registry, collection, nullifiers, parked, next_qid);
        return ();
    }

    if (op == op::set_collection) {
        throw_unless(err::not_admin, equal_slices(sender, admin));
        slice new_collection = in_msg_body~load_msg_addr();
        save_data(admin, registry, new_collection, nullifiers, parked, next_qid);
        return ();
    }

    if (op == op::set_admin) {
        throw_unless(err::not_admin, equal_slices(sender, admin));
        slice new_admin = in_msg_body~load_msg_addr();
        save_data(new_admin, registry, collection, nullifiers, parked, next_qid);
        return ();
    }

    throw(err::unknown_op);
}

;; ===========================================================
;; Get methods
;; ===========================================================

int nullifier_used?(int nf) method_id {
    var (_, _, _, nullifiers, _, _) = load_data();
    var (_, found) = nullifiers.udict_get?(SCALAR_BITS, nf);
    if (found) { return 1; }
    return 0;
}

int chain_id() method_id {
    return CHAIN_ID;
}

(int, slice) parked_entry(int q) method_id {
    var (_, _, _, _, parked, _) = load_data();
    var (cellopt, found) = parked.udict_get_ref?(QUERY_ID_BITS, q);
    if (~ found) { return (0, null()); }
    return (1, cellopt.begin_parse());
}

slice registry_address() method_id {
    var (_, registry, _, _, _, _) = load_data();
    return registry;
}

slice collection_address() method_id {
    var (_, _, collection, _, _, _) = load_data();
    return collection;
}

int next_query_id() method_id {
    var (_, _, _, _, _, next_qid) = load_data();
    return next_qid;
}
