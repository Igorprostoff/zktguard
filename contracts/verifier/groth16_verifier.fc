#include "../imports/stdlib.fc";

;; ===========================================================
;; Groth16 verifier on TON for zkTGuard v0.2.
;;
;; Phase A: real BLS12-381 VK baked in from
;;   circuits/account_age/verification_key.json. Regenerate by running
;;   circuits/scripts/setup.sh then circuits/scripts/vk_to_func.js.
;;
;; Phase C: the verifier no longer mints synchronously. The flow is
;;
;;   1. `op::verify_claim` arrives.
;;   2. Validate point arity, group membership, chain_id, expiration,
;;      and the four-pair Groth16 equation. Reject with the usual
;;      401–413 exit codes on failure.
;;   3. Park the proof under a fresh query_id and send
;;      `op::query_registered` to the configured registry.
;;   4. `op::query_reply` arrives from the registry.
;;   5. If the registry says yes, check nullifier reuse (402), record
;;      the nullifier, and send `op::mint` to the configured soulbound
;;      collection. If the registry says no, drop the parked entry.
;;   6. `op::sweep_expired` (admin) clears parked entries past their
;;      TTL.
;;
;; Public-input vector (8 scalars, BLS12-381 scalar field):
;;     pi[0]  = nullifier      (circuit output)
;;     pi[1]  = nonce          (high 32 bits carry chain_id)
;;     pi[2]  = app_id
;;     pi[3]  = expiration     (Unix seconds)
;;     pi[4]  = claim_type
;;     pi[5]  = attestor_pubkey_x
;;     pi[6]  = attestor_pubkey_y
;;     pi[7]  = threshold_months
;; ===========================================================

int equal_slices(slice a, slice b) asm "SDEQ";

;; ---------- Op codes ----------

const int op::verify_claim     = 0x76657266;   ;; "verf"
const int op::query_registered = 0x71726567;   ;; matches AppRegistry
const int op::query_reply      = 0x7172706c;
const int op::mint             = 0x6d696e74;   ;; matches SoulboundCollection
const int op::sweep_expired    = 0x73776570;   ;; "swep"
const int op::set_registry     = 0x73726567;   ;; "sreg"
const int op::set_collection   = 0x73636f6c;   ;; "scol"
const int op::set_admin        = 0x7361646d;   ;; "sadm"

;; ---------- Error codes (see ERRORS.md) ----------

const int err::invalid_proof       = 401;
const int err::nullifier_used      = 402;
const int err::expired             = 403;
const int err::chain_mismatch      = 405;
const int err::malformed_input     = 411;
const int err::not_on_curve_g1     = 412;
const int err::not_on_curve_g2     = 413;
const int err::not_registry        = 430;
const int err::unknown_query_id    = 431;
const int err::not_admin           = 432;
const int err::registry_unset      = 433;
const int err::collection_unset    = 434;
const int err::unknown_op          = 0xffff;

;; ---------- Constants ----------

const int CHAIN_ID         = 1;     ;; testnet binding

const int G1_BITS = 48 * 8;
const int G2_BITS = 96 * 8;
const int SCALAR_BITS = 256;
const int CHAIN_ID_BITS = 32;
const int NONCE_RANDOM_BITS = SCALAR_BITS - CHAIN_ID_BITS;
const int QUERY_ID_BITS = 64;
const int APP_ID_BITS = 64;
const int CLAIM_BITS = 32;
const int EXPIRATION_BITS = 64;
const int TIMESTAMP_BITS = 32;
const int TTL_BITS = 32;
const int DEFAULT_TTL_SECONDS = 3600;     ;; 1 hour

;; ---------- BLS asm bindings ----------

slice bls_g1_neg(slice x)         asm "BLS_G1_NEG";
int   bls_g1_in_group(slice x)    asm "BLS_G1_INGROUP";
int   bls_g2_in_group(slice x)    asm "BLS_G2_INGROUP";

int bls_pairing_4(
    slice g1a, slice g2a,
    slice g1b, slice g2b,
    slice g1c, slice g2c,
    slice g1d, slice g2d
) asm "4 PUSHINT BLS_PAIRING";

slice bls_g1_add(slice x, slice y) asm "BLS_G1_ADD";

slice bls_g1_multiexp_4(
    slice p0, int s0, slice p1, int s1,
    slice p2, int s2, slice p3, int s3
) asm "4 PUSHINT BLS_G1_MULTIEXP";

slice bls_g1_multiexp_5(
    slice p0, int s0, slice p1, int s1, slice p2, int s2,
    slice p3, int s3, slice p4, int s4
) asm "5 PUSHINT BLS_G1_MULTIEXP";

;; ===========================================================
;; Verification key constants (real Phase-A output)
;; ===========================================================

slice vk_alpha_g1() inline {
    return begin_cell()
        .store_uint(0x930A47C7371FBDFCED1C766D2FFE495305005E641CE3EDAA, 192)
        .store_uint(0x53C29A699467BC93DAA352346290D67863E0F020001F792F, 192)
        .end_cell().begin_parse();
}

