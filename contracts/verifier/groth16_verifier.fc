#include "../imports/stdlib.fc";

;; ===========================================================
;; Groth16 verifier on TON for zkTGuard v0.1.
;;
;; PLACEHOLDER VK — the constants embedded below correspond to a
;; toy trusted setup with all scalars set to small fixed values
;; (alpha = beta = gamma = delta = 1; IC scalars 7, 101..108).
;; This makes it trivial to craft proofs in TS for end-to-end
;; sandbox tests *without* having a real circuit/proving-key pair
;; built yet. DO NOT DEPLOY TO MAINNET. The real VK lands when
;; Task 3 (trusted setup) ships and Task 4 is regenerated.
;;
;; Public-input vector (8 scalars), in the same order as the
;; account_age circuit's `public []` declaration:
;;
;;     pi[0]  = nonce          (high 32 bits carry chain_id —
;;                              see chain_id_from_nonce below)
;;     pi[1]  = app_id
;;     pi[2]  = expiration     (Unix seconds)
;;     pi[3]  = claim_type
;;     pi[4]  = nullifier
;;     pi[5]  = attestor_pubkey_x
;;     pi[6]  = attestor_pubkey_y
;;     pi[7]  = threshold_months
;; ===========================================================

;; ---------- Op codes ----------

const int op::verify_claim = 0x76657266;   ;; "verf"

;; ---------- Error codes (see ERRORS.md) ----------

const int err::invalid_proof       = 401;
const int err::nullifier_used      = 402;
const int err::expired             = 403;
const int err::unknown_app         = 404;
const int err::chain_mismatch      = 405;
const int err::malformed_input     = 411;
const int err::not_on_curve_g1     = 412;
const int err::not_on_curve_g2     = 413;
const int err::unknown_op          = 0xffff;

;; ---------- Constants ----------
;; Chain identifier baked into the high 32 bits of the public
;; nonce by the prover. v0 uses 1 for testnet sandbox tests.

const int CHAIN_ID         = 1;
const int ACCEPTED_APP_ID  = 1;     ;; v0 stub for registry lookup
const int ACCEPTED_CLAIM   = 1;

const int G1_BITS = 48 * 8;
const int G2_BITS = 96 * 8;
const int SCALAR_BITS = 256;
const int CHAIN_ID_BITS = 32;
const int NONCE_RANDOM_BITS = SCALAR_BITS - CHAIN_ID_BITS;

;; ---------- BLS asm bindings ----------

slice bls_g1_neg(slice x)         asm "BLS_G1_NEG";
int   bls_g1_in_group(slice x)    asm "BLS_G1_INGROUP";
int   bls_g2_in_group(slice x)    asm "BLS_G2_INGROUP";

;; Four-pair pairing: e(g1a,g2a) * e(g1b,g2b) * e(g1c,g2c) * e(g1d,g2d) == 1?
int bls_pairing_4(
    slice g1a, slice g2a,
    slice g1b, slice g2b,
    slice g1c, slice g2c,
    slice g1d, slice g2d
) asm "4 PUSHINT BLS_PAIRING";

;; FunC's asm directive caps argument count at 16, so the 9-term
;; multiexp needed for vk_x is split into a 4-term and a 5-term
;; call combined by BLS_G1_ADD.

slice bls_g1_add(slice x, slice y) asm "BLS_G1_ADD";

slice bls_g1_multiexp_4(
    slice p0, int s0, slice p1, int s1,
    slice p2, int s2, slice p3, int s3
) asm "4 PUSHINT BLS_G1_MULTIEXP";

slice bls_g1_multiexp_5(
    slice p0, int s0, slice p1, int s1, slice p2, int s2,
    slice p3, int s3, slice p4, int s4
) asm "5 PUSHINT BLS_G1_MULTIEXP";

;; ===========================================================
;; Verification key constants (PLACEHOLDER — see header).
;; ===========================================================

slice vk_alpha_g1() inline {
    return begin_cell()
        .store_uint(0x97F1D3A73197D7942695638C4FA9AC0FC3688C4F9774B905, 192)
        .store_uint(0xA14E3A3F171BAC586C55E83FF97A1AEFFB3AF00ADB22C6BB, 192)
        .end_cell().begin_parse();
}

