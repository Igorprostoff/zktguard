        .store_uint(0x2A04666442AC0D40C9CB42C7531117B3459F0C4767EF05F3, 192)
        .store_uint(0x11BD90947FC1615AF1140AD80A268B3A880C70BA5A8CAF23, 192)
        .store_uint(0x364B47430C3B13C52A67E7713845CFEAC6564F823743F9A7, 192)
