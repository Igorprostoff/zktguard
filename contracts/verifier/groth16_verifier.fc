    return begin_cell()
        .store_uint(0x93E02B6052719F607DACD3A088274F65596BD0D09920B61A, 192)
        .store_uint(0xB5DA61BBDC7F5049334CF11213945D57E5AC7D055D042B7E, 192)
        .store_uint(0x024AA2B2F08F0A91260805272DC51051C6E47AD4FA403B02, 192)
        .store_uint(0xB4510B647AE3D1770BAC0326A805BBEFD48056C8C121BDB8, 192)
        .end_cell().begin_parse();
}

