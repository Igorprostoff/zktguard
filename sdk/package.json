{
  "name": "@zktguard/sdk",
  "version": "0.0.0",
  "description": "TypeScript client for zkTGuard: verify a Telegram-derived credential on TON.",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2022",
    "test": "jest --runInBand",
    "size": "node scripts/size.cjs"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@ton/core": "^0.62.0",
    "@ton/ton": "^15.4.0"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.32.0",
    "@ton/test-utils": "^0.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@ton/core": "^0.62.0"
  }
}
