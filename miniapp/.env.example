# Copy this file to .env.local and edit as needed. Defaults match the
# v0.2 Phase-D1 testnet deployment.

VITE_NETWORK=testnet

# v0.2 Phase-D1 testnet verifier (TON testnet, workchain 0).
# Live address: https://testnet.tonscan.org/address/kQB4g0yg0VmIQBX2Le_2ZVIE1F-k4BsXKl2Gkf3DroyVo9k1
VITE_VERIFIER_ADDRESS=kQB4g0yg0VmIQBX2Le_2ZVIE1F-k4BsXKl2Gkf3DroyVo9k1

# Local off-chain stack (Docker Compose in infra/, or bare-metal services).
VITE_ATTESTOR_URL=http://127.0.0.1:7677
VITE_PROVER_URL=http://127.0.0.1:7679

# TON Connect manifest. Replace with your hosted manifest URL when
# deploying the Mini App somewhere reachable from a phone.
VITE_TONCONNECT_MANIFEST_URL=https://example.com/tonconnect-manifest.json
