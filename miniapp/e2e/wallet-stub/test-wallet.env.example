# Wallet seed for the Playwright e2e stub.
#
# TESTNET ONLY. Never reuse this seed for mainnet. The same wallet
# is also configured as a GitHub Actions environment secret on the
# `test` environment so the e2e-testnet workflow can pick it up.
#
# Format: 24 whitespace-separated BIP-39 words.

WALLET_STUB_MNEMONIC="word1 word2 word3 ... word24"
